---
import { execSync } from 'child_process';
const version = execSync('git log -1 --format=%s').toString().trim();

const NavLinks = [
    {
        name : 'Nicholas Barbieri',
        url: '#hero',
        style: 'h4',
    },
    {
        name : 'Projects',
        url: '#projects',
        style: 'small',
    },
    
    {
        name : 'Who am I?',
        url: '#who',
        style: 'small',
    },
    {
        name : 'Contacts',
        url: '#contacts',
        style: 'small',
    }
]
---

<nav id="main-nav" class="fixed top-0 left-0 z-50 md:h-screen mix-blend-difference pointer-events-none flex flex-col md:justify-between" style="color: var(--blend-color)">
    <div class="pl-2 pt-1 md:pl-8 md:pr-8 md:pb-8">
        <ul class="nav-links pointer-events-none" role="navigation">
            {NavLinks.map(link => (
                <li role="none" class:list={[link.style === 'small' && 'hidden md:block']}>
                    <a href={link.url} class={`btn btn--${link.style} pointer-events-auto`} nav-link data-typewriter>{link.name}</a>
                </li>
            ))}
        </ul>
    </div>
    <div class="pl-8 hidden md:block">
        <slot name="nav-bottom">
            <small
              data-typewriter
              data-typewriter-text={`Copyright © 2026 Nicholas Barbieri - nick_flick@outlook.com - ${version}`}
            >Copyright © 2026 Nicholas Barbieri - <a href="mailto:nick_flick@outlook.com" class="link-ext pointer-events-auto">nick_flick@outlook.com</a> - {version}</small>
        </slot>
    </div>
</nav>

<script>
  // Compute nav blend color: sec − key per channel so mix-blend-difference renders as keycolor over seccolor
  (function () {
    const cs  = getComputedStyle(document.documentElement);
    const hex = (v: string) => v.trim().replace('#', '');
    const toRgb = (h: string) => [0,2,4].map(i => parseInt(h.slice(i,i+2), 16));
    const toHex = (ch: number[]) => '#' + ch.map(v => Math.max(0,Math.min(255,v)).toString(16).padStart(2,'0')).join('');

    const sec = toRgb(hex(cs.getPropertyValue('--seccolor')));
    const key = toRgb(hex(cs.getPropertyValue('--keycolor')));
    const nav = toHex(sec.map((v, i) => v - key[i]));

    document.documentElement.style.setProperty('--blend-color', nav);
  })();

  const links = document.querySelectorAll<HTMLAnchorElement>('[nav-link]');

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        const id = entry.target.id;
        links.forEach((link) => {
          const matches = link.getAttribute('href') === `#${id}`;
          link.classList.toggle('is-active', matches);
        });
      });
    },
    { threshold: 0.4 }
  );

  links.forEach((link) => {
    const id = link.getAttribute('href')?.slice(1);
    if (id) {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    }
  });
</script>

