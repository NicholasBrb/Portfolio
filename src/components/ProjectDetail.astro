---
// Layout base delle slide di dettaglio.
// Anno, tag e titolo non servono qui: restano visibili sulla card (stato "open").
// Personalizza questo file oppure crea un componente dedicato per un singolo progetto.

import type { ProjectData } from '../data/projects';

interface Props {
  project: ProjectData;
}
const { project } = Astro.props;

const slides = project.slides ?? [];
const count = slides.length > 0 ? slides.length : 4;

// Testo del primo pannello: usa description del progetto se slide 1 non ha la propria
const firstText = (i: number) =>
  i === 0 ? (slides[0]?.description ?? project.description) : slides[i]?.description;

// Splits a description on \n\n into paragraphs; \n within a paragraph stays as a line break
const paras = (str: string | undefined): string[] =>
  str ? str.split('\n\n').map(p => p.trim()).filter(Boolean) : [];
---

<div
  class="project-detail w-full"
  data-for={project.id}
  style="max-height: 0; overflow: hidden; transition: max-height 0.55s cubic-bezier(0.4, 0, 0.2, 1);"
>
  {Array.from({ length: count }).map((_, i) => {
    const slide = slides[i];
    const text = firstText(i);

    if (slide?.vimeoId && !slide.layout) {
      const src = `https://player.vimeo.com/video/${slide.vimeoId}?badge=0&autopause=0&player_id=0&app_id=58479&loop=1`;
      return (
        <section class="slide">
          <div class="slide-content grid grid-cols-4 gap-2 pl-2 pr-2 w-full h-full">

            {/* Iframe (3/4) */}
            <div class="slide-media col-span-3 mr-1 overflow-hidden  relative">
              <iframe
                src={src}
                class="absolute inset-0 w-full h-full"
                frameborder="0"
                allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media; web-share"
                referrerpolicy="strict-origin-when-cross-origin"
                title={project.title}
              />
            </div>

            {/* Testo (1/4) — identico alla slide default */}
            <div class="slide-text col-span-1 relative pl-2">
              {i === 0 && (project.client || project.role) && (
                <div class="absolute top-0 left-2 flex flex-col gap-3">
                  {project.client && (
                    <div>
                      <p class="text-sm leading-none" style="text-indent:0">Client</p>
                      <p class="text-sm leading-none" style="text-indent:0">{project.client}</p>
                    </div>
                  )}
                  {project.role && (
                    <div>
                      <p class="text-sm leading-none" style="text-indent:0">Role</p>
                      <p class="text-sm leading-none" style="text-indent:0">{project.role}</p>
                    </div>
                  )}
                </div>
              )}
              {(paras(text).length > 0 || (i === 0 && project.links && project.links.length > 0)) && (
                <div class="absolute bottom-0 left-2 right-0">
                  {paras(text).map(p => (
                    <p class="text-sm leading-snug opacity-70 whitespace-pre-line">{p}</p>
                  ))}
                  {i === 0 && project.links && project.links.length > 0 && (
                    <div class="flex flex-wrap gap-x-3 mt-1">
                      {project.links.map(link => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-ext text-sm leading-snug opacity-70">
                          {link.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>

          </div>
          {i === 0 && (
            <div class="print-title-overlay">
              <p class="text-xs font-light tracking-widest leading-none" style="text-indent:0">{project.year}</p>
              <h4 class="leading-tight">{project.title}</h4>
            </div>
          )}
        </section>
      );
    }

    if (slide?.layout === 'stack-video') {
      return (
        <section class="slide">
          <div class="slide-content flex gap-2 pl-2 pr-2 w-full">

            {/* Sinistra: 2 immagini sovrapposte */}
            <div class="slide-media flex flex-col flex-1 gap-2 min-w-0">
              <div class="flex-1 overflow-hidden  min-h-0">
                {slide.images?.[0]
                  ? <img src={slide.images[0]} alt={`${project.title} – top`} class=" h-full object-cover object-left block" loading="lazy" />
                  : <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">img A</div>
                }
              </div>
              <div class="flex-1 overflow-hidden  min-h-0">
                {slide.images?.[1]
                  ? <img src={slide.images[1]} alt={`${project.title} – bottom`} class=" h-full object-cover object-left block" loading="lazy" />
                  : <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">img B</div>
                }
              </div>
            </div>

            {/* Destra: video in loop senza audio né controlli, ritagliato */}
            <div class="slide-media flex-1 overflow-hidden  min-h-0 relative">
              {slide.video
                ? <video src={slide.video} autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover" />
                : slide.vimeoId
                ? <div class="absolute inset-0 overflow-hidden">
                    <iframe
                      src={`https://player.vimeo.com/video/${slide.vimeoId}?background=1&badge=0&autopause=0&player_id=0&app_id=58479`}
                      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full pointer-events-none"
                      style="width: max(100%, calc(100vh * 16/9)); height: max(100%, calc(100vw * 9/16));"
                      frameborder="0"
                      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
                      title=""
                    />
                  </div>
                : <div class="absolute inset-0 flex items-center justify-center text-neutral-300 text-xs tracking-widest">video</div>
              }
            </div>

          </div>
          {i === 0 && (
            <div class="print-title-overlay">
              <p class="text-xs font-light tracking-widest leading-none" style="text-indent:0">{project.year}</p>
              <h4 class="leading-tight">{project.title}</h4>
            </div>
          )}
        </section>
      );
    }



    if (slide?.layout === 'stack-poster') {
      const ratio = slide.posterRatio ?? '210/297';
      return (
        <section class="slide">
          <div class="slide-content flex gap-2 pl-2 pr-2 w-full">

            {/* Sinistra: 2 immagini sovrapposte che riempiono lo spazio rimanente */}
            <div class="slide-media flex flex-col flex-1 gap-2 min-w-0">
              <div class="flex-1 overflow-hidden  min-h-0">
                {slide.images?.[0]
                  ? <img src={slide.images[0]} alt={`${project.title} – top`} class="w-full h-full object-cover block" loading="lazy" />
                  : <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">img A</div>
                }
              </div>
              <div class="flex-1 overflow-hidden  min-h-0">
                {slide.images?.[1]
                  ? <img src={slide.images[1]} alt={`${project.title} – bottom`} class="w-full h-full object-cover block" loading="lazy" />
                  : <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">img B</div>
                }
              </div>
            </div>

            {/* Destra: poster — altezza = altezza slide, larghezza ricavata dall'aspect-ratio */}
            <div
              class="slide-media flex-none h-full overflow-hidden "
              style={`aspect-ratio: ${ratio};`}
            >
              {slide.image
                ? <img src={slide.image} alt={`${project.title} – poster`} class="w-full h-full object-cover block" loading="lazy" />
                : <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">poster</div>
              }
            </div>

          </div>
          {i === 0 && (
            <div class="print-title-overlay">
              <p class="text-xs font-light tracking-widest leading-none" style="text-indent:0">{project.year}</p>
              <h4 class="leading-tight">{project.title}</h4>
            </div>
          )}
        </section>
      );
    }

    if (slide?.layout === 'full-image') {
      return (
        <section class="slide">
          <div class="slide-content flex-1 pl-2 pr-2 flex overflow-hidden">
            <div class="slide-media flex-1 overflow-hidden ">
              {slide.video ? (
                <video src={slide.video} autoplay loop muted playsinline class="w-full h-full object-cover block" />
              ) : slide.vimeoId ? (
                <div class="relative w-full h-full overflow-hidden">
                  <iframe
                    src={`https://player.vimeo.com/video/${slide.vimeoId}?background=1&badge=0&autopause=0&player_id=0&app_id=58479`}
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none"
                    style="width: max(100%, calc(100vh * 16/9)); height: max(100%, calc(100vw * 9/16));"
                    frameborder="0"
                    allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
                    title=""
                  />
                </div>
              ) : slide.image ? (
                <img src={slide.image} alt={`${project.title} – ${i + 1}`} class="w-full h-full object-cover block" loading="lazy" />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">img</div>
              )}
            </div>
          </div>
          {i === 0 && (
            <div class="print-title-overlay">
              <p class="text-xs font-light tracking-widest leading-none" style="text-indent:0">{project.year}</p>
              <h4 class="leading-tight">{project.title}</h4>
            </div>
          )}
        </section>
      );
    }

    if (slide?.layout === 'two-images') {
      return (
        <section class="slide">
          <div class="slide-content flex gap-2 pl-2 pr-2 w-full h-full">
            <div class="slide-media flex-1 overflow-hidden ">
              {slide.images?.[0]
                ? <img src={slide.images[0]} alt={`${project.title} – 1`} class="w-full h-full object-cover block" loading="lazy" />
                : <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">img A</div>
              }
            </div>
            <div class="slide-media flex-1 overflow-hidden ">
              {slide.images?.[1]
                ? <img src={slide.images[1]} alt={`${project.title} – 2`} class="w-full h-full object-cover block" loading="lazy" />
                : <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">img B</div>
              }
            </div>
          </div>
          {i === 0 && (
            <div class="print-title-overlay">
              <p class="text-xs font-light tracking-widest leading-none" style="text-indent:0">{project.year}</p>
              <h4 class="leading-tight">{project.title}</h4>
            </div>
          )}
        </section>
      );
    }

    if (slide?.layout === 'image-text') {
      return (
        <section class="slide">
          <div class="slide-content grid grid-cols-4 gap-2 pl-2 pr-2 w-full">

            {/* Immagine (3/4) */}
            <div class="slide-media col-span-3 overflow-hidden  h-full self-start">
              {slide.video ? (
                <video
                  src={slide.video}
                  autoplay
                  loop
                  muted
                  playsinline
                  class="w-full h-full object-cover block pr-1"
                />
              ) : slide.vimeoId ? (
                <div class="relative w-full h-full overflow-hidden">
                  <iframe
                    src={`https://player.vimeo.com/video/${slide.vimeoId}?background=1&badge=0&autopause=0&player_id=0&app_id=58479`}
                    class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none"
                    style="width: max(100%, calc(100vh * 16/9)); height: max(100%, calc(100vw * 9/16));"
                    frameborder="0"
                    allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
                    title=""
                  />
                </div>
              ) : slide.image ? (
                <img
                  src={slide.image}
                  alt={`${project.title} – ${i + 1}`}
                  class="w-full h-full object-cover block pr-1"
                  loading="lazy"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">
                  slide {i + 1}
                </div>
              )}
            </div>

            {/* Testo (1/4) */}
            <div class="slide-text col-span-1 relative pl-2">
              {i === 0 && (project.client || project.role) && (
                <div class="absolute top-0 left-2 flex flex-col gap-3">
                  {project.client && (
                    <div>
                      <p class="text-sm leading-none" style="text-indent:0">Client</p>
                      <p class="text-sm leading-none" style="text-indent:0">{project.client}</p>
                    </div>
                  )}
                  {project.role && (
                    <div>
                      <p class="text-sm leading-none" style="text-indent:0">Role</p>
                      <p class="text-sm leading-none" style="text-indent:0">{project.role}</p>
                    </div>
                  )}
                </div>
              )}
              {(paras(text).length > 0 || (i === 0 && project.links && project.links.length > 0)) && (
                <div class="absolute bottom-0 left-2 right-0">
                  {paras(text).map(p => (
                    <p class="text-sm leading-snug whitespace-pre-line">{p}</p>
                  ))}
                  {i === 0 && project.links && project.links.length > 0 && (
                    <div class="flex flex-wrap gap-x-3 mt-1">
                      {project.links.map(link => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-ext text-sm leading-snug">
                          {link.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>

          </div>
          {i === 0 && (
            <div class="print-title-overlay">
              <p class="text-xs font-light tracking-widest leading-none" style="text-indent:0">{project.year}</p>
              <h4 class="leading-tight">{project.title}</h4>
            </div>
          )}
        </section>
      );
    }

    if (slide?.layout === 'hero-video') {
      return (
        <section class="slide">
          <div class="slide-content grid grid-cols-4 gap-2 pl-2 pr-2 w-full h-full">

            {/* Video (3/4) — stesse colonne del layout default, iframe come stack-video */}
            <div class="slide-media col-span-3 overflow-hidden  relative mr-1">
              {slide.vimeoId
                ? <div class="absolute inset-0 overflow-hidden">
                    <iframe
                      src={`https://player.vimeo.com/video/${slide.vimeoId}?background=1&badge=0&autopause=0&player_id=0&app_id=58479`}
                      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full h-full pointer-events-none"
                      style="width: max(100%, calc(100vh * 16/9)); height: max(100%, calc(100vw * 9/16));"
                      frameborder="0"
                      allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
                      title=""
                    />
                  </div>
                : slide.video
                ? <video src={slide.video} autoplay loop muted playsinline class="absolute inset-0 w-full h-full object-cover" />
                : <div class="absolute inset-0 flex items-center justify-center text-neutral-300 text-xs tracking-widest">video</div>
              }
            </div>

            {/* Testo (1/4) */}
            <div class="slide-text col-span-1 relative pl-2">
              {i === 0 && (project.client || project.role) && (
                <div class="absolute top-0 left-2 flex flex-col gap-3">
                  {project.client && (
                    <div>
                      <p class="text-sm leading-none" style="text-indent:0">Client</p>
                      <p class="text-sm leading-none" style="text-indent:0">{project.client}</p>
                    </div>
                  )}
                  {project.role && (
                    <div>
                      <p class="text-sm leading-none" style="text-indent:0">Role</p>
                      <p class="text-sm leading-none" style="text-indent:0">{project.role}</p>
                    </div>
                  )}
                </div>
              )}
              {(paras(text).length > 0 || (i === 0 && project.links && project.links.length > 0)) && (
                <div class="absolute bottom-0 left-2 right-0">
                  {paras(text).map(p => (
                    <p class="text-sm leading-snug whitespace-pre-line">{p}</p>
                  ))}
                  {i === 0 && project.links && project.links.length > 0 && (
                    <div class="flex flex-wrap gap-x-3 mt-1">
                      {project.links.map(link => (
                        <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-ext text-sm leading-snug">
                          {link.label} ↗
                        </a>
                      ))}
                    </div>
                  )}
                </div>
              )}
            </div>

          </div>
          {i === 0 && (
            <div class="print-title-overlay">
              <p class="text-xs font-light tracking-widest leading-none" style="text-indent:0">{project.year}</p>
              <h4 class="leading-tight">{project.title}</h4>
            </div>
          )}
        </section>
      );
    }

    return (
      <section class="slide">
        <div class="slide-content grid grid-cols-4 gap-2 pl-2 pr-2 w-full">

          {/* Immagine (3/4) */}
          <div class="slide-media col-span-3 overflow-hidden  h-full self-start">
            {slide?.video ? (
              <video
                src={slide.video}
                autoplay
                loop
                muted
                playsinline
                class="w-full h-full object-cover block pr-1"
              />
            ) : slide?.vimeoId ? (
              <div class="relative w-full overflow-hidden" style="aspect-ratio: 4/3;">
                <iframe
                  src={`https://player.vimeo.com/video/${slide.vimeoId}?background=1&badge=0&autopause=0&player_id=0&app_id=58479`}
                  class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none"
                  style="width: max(100%, calc(100vh * 16/9)); height: max(100%, calc(100vw * 9/16));"
                  frameborder="0"
                  allow="autoplay; fullscreen; picture-in-picture; clipboard-write; encrypted-media"
                  title=""
                />
              </div>
            ) : slide?.image ? (
              <img
                src={slide.image}
                alt={`${project.title} – ${i + 1}`}
                class="w-full h-full object-cover block pr-1"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full flex items-center justify-center text-neutral-300 text-xs tracking-widest">
                slide {i + 1}
              </div>
            )}
          </div>

          {/* Testo (1/4) */}
          <div class="slide-text col-span-1 relative pl-2">
            {/* Client e Ruolo — solo slide 1, ancorati al top dell'immagine */}
            {i === 0 && (project.client || project.role) && (
              <div class="absolute top-0 left-2 flex flex-col gap-3">
                {project.client && (
                  <div>
                    <p class="text-sm leading-none" style="text-indent:0">Client</p>
                    <p class="text-sm leading-none" style="text-indent:0">{project.client}</p>
                  </div>
                )}
                {project.role && (
                  <div>
                    <p class="text-sm leading-none" style="text-indent:0">Role</p>
                    <p class="text-sm leading-none" style="text-indent:0">{project.role}</p>
                  </div>
                )}
              </div>
            )}
            {/* Descrizione e link — ancorati al bottom dell'immagine */}
            {(paras(text).length > 0 || (i === 0 && project.links && project.links.length > 0)) && (
              <div class="absolute bottom-0 left-2 right-0">
                {paras(text).map(p => (
                  <p class="text-sm leading-snug whitespace-pre-line">{p}</p>
                ))}
                {i === 0 && project.links && project.links.length > 0 && (
                  <div class="flex flex-wrap gap-x-3 mt-1">
                    {project.links.map(link => (
                      <a href={link.url} target="_blank" rel="noopener noreferrer" class="link-ext text-sm leading-snug">
                        {link.label} ↗
                      </a>
                    ))}
                  </div>
                )}
              </div>
            )}
          </div>

        </div>
          {i === 0 && (
            <div class="print-title-overlay">
              <p class="text-xs font-light tracking-widest leading-none" style="text-indent:0">{project.year}</p>
              <h4 class="leading-tight">{project.title}</h4>
            </div>
          )}
      </section>
    );
  })}

</div>
